   // ✅ NEW: Check Phantom's actual state on initial load
useEffect(() => {
  console.log("🔍 [InitialSync] Checking Phantom's actual connection state...");
  
  if (typeof window === 'undefined') return;
  
  const phantom = window.phantom?.solana;
  
  if (!phantom?.isPhantom) {
    console.log("❌ [InitialSync] Phantom wallet not detected");
    return;
  }
  
  // Check if Phantom says it's connected but our React state doesn't know
  const isActuallyConnected = phantom.isConnected;
  const phantomPublicKey = phantom.publicKey?.toString();
  
  console.log("📊 [InitialSync] Phantom reports:", {
    isConnected: isActuallyConnected,
    publicKey: phantomPublicKey,
    ourStateConnected: connected, // Your existing connected state
    ourStatePublicKey: publicKey?.toString() // Your existing publicKey state
  });
  
  // If Phantom says connected but our state says disconnected - FIX IT
  if (isActuallyConnected && phantomPublicKey && (!connected || !publicKey)) {
    console.log("🔄 [InitialSync] Fixing state mismatch: Phantom is connected but app doesn't know!");
    
    // Update your connection state (assuming you have setters or context)
    // This depends on how you manage wallet state. Examples:
    
    // If you're using a wallet context/provider:
    // connect(); // Call your connect function
    
    // If you have state setters:
    // setConnected(true);
    // setPublicKey(new PublicKey(phantomPublicKey));
    
    console.log("✅ [InitialSync] State corrected to match Phantom");
  } else if (!isActuallyConnected && connected) {
    console.log("🔄 [InitialSync] Fixing: App thinks connected but Phantom says disconnected");
    // Handle disconnect
  }
  
  // Set up event listeners to keep in sync
  const handlePhantomConnect = (eventPublicKey: any) => {
    console.log("🔗 [Event] Phantom 'connect' event received");
    // Your existing connection logic should handle this
  };
  
  const handlePhantomDisconnect = () => {
    console.log("🔌 [Event] Phantom 'disconnect' event received");
    // Your disconnect logic should handle this
  };
  
  if (phantom) {
    phantom.on('connect', handlePhantomConnect);
    phantom.on('disconnect', handlePhantomDisconnect);
  }
  
  return () => {
    if (phantom) {
      phantom.off('connect', handlePhantomConnect);
      phantom.off('disconnect', handlePhantomDisconnect);
    }
  };
}, []); // Run once on mount

