useEffect(() => {
  const attemptConnection = async () => {
    if (connected || walletConnecting) return;
    
    // Check for Phantom
    if (typeof window === 'undefined') return;
    const phantom = window.phantom?.solana;
    if (!phantom?.isPhantom) {
      console.log("👻 Phantom not found");
      return;
    }
    
    // 🆕 NEW CHECK: If Phantom says it's already connected, sync state
    if (phantom.isConnected && phantom.publicKey && !connected) {
      console.log("✅ [AutoConnect] Phantom already connected - syncing state");
      
      const phantomPublicKey = phantom.publicKey.toString();
      console.log("🔑 Public key from Phantom:", phantomPublicKey);
      
      // Update your state to match Phantom
      // This depends on your state management. Example:
      // setConnected(true);
      // setPublicKey(new PublicKey(phantomPublicKey));
      
      // Don't try to connect again if already connected
      return;
    }
    
    // Only attempt connection if Phantom isn't already connected
    try {
      console.log("🔄 [AutoConnect] Attempting silent Phantom connection...");
      const response = await phantom.connect({ onlyIfTrusted: true });
      console.log("✅ [AutoConnect] Phantom auto-connected:", response.publicKey.toString());
    } catch (error) {
      console.log("ℹ [AutoConnect] Phantom requires manual connection");
    }
  };
  
  // 🆕 CHANGE: Shorter delay for better UX
  const timer = setTimeout(attemptConnection, 500); // Changed from 1500ms to 500ms
  return () => clearTimeout(timer);
}, [connected, walletConnecting]);

// ✅ NEW: Periodic state verification
useEffect(() => {
  // Don't run if no Phantom or already syncing
  if (typeof window === 'undefined' || walletConnecting) return;
  
  const interval = setInterval(() => {
    verifyWalletState();
  }, 3000); // Check every 3 seconds
  
  return () => clearInterval(interval);
}, [walletConnecting]);

