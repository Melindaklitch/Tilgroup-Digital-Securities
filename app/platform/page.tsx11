 const fetchBalances = React.useCallback(async (pubkeyStr: string) => {
    if (TEST_MODE) {
      setSolBalance(10000);
      setUsdcBalance(5000);
      return;
    }

    try {
      const pubkey = new PublicKey(pubkeyStr);
      const lamports = await connection.getBalance(pubkey);
      setSolBalance(lamports / LAMPORTS_PER_SOL);

      const resp = await connection.getParsedTokenAccountsByOwner(pubkey, {
        programId: new PublicKey(
          "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA"
        ),
      });

           let usdcAmt = 0;
     resp.value.forEach((acc) => {
     const parsed = acc.account.data as ParsedAccountData;
        const info: any = parsed.parsed?.info;
        if (info?.mint === TOKENS[1].mint) {
          usdcAmt = info.tokenAmount?.uiAmount ?? 0;
        }
      });
      setUsdcBalance(usdcAmt);
    } catch (err) {
      console.error("Balance fetch failed", err);
    }
  }, [connection, TEST_MODE]); // ✅ Add dependencies

