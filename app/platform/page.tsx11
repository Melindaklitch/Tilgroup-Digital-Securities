     async function confirmTransaction() {
  if (!walletAddress || !selectedAsset || !session?.user?.id) {
    alert(t("errors.missing_information")); // Use translation
    return;
  }

  try {
    const usdPrice = selectedAsset.price;
    const quantity = selectedAsset.quantity || 1;
    const totalUSD = usdPrice * quantity;
    
    console.log("🔍 Transaction Debug:", { 
      selectedToken, 
      totalUSD, 
      asset: selectedAsset,
      assetKey: selectedAsset.key,
      assetNameKey: selectedAsset.nameKey 
    });

    // Balance checks with proper error messages
    if (selectedToken === "SOL") {
      const mockSolPrice = 150;
      const solRequired = totalUSD / mockSolPrice;
      if ((solBalance || 0) < solRequired) {
        alert(t("errors.insufficient_balance", { 
          token: "SOL", 
          required: solRequired.toFixed(4) 
        }));
        return;
      }
    } else if (selectedToken === "USDC") {
      if ((usdcBalance || 0) < totalUSD) {
        alert(t("errors.insufficient_balance", { 
          token: "USDC", 
          required: totalUSD.toFixed(2) 
        }));
        return;
      }
    }

    // SIMULATE TRANSACTION
    let txSignature = `simulated-${selectedToken.toLowerCase()}-${Date.now()}`;
    let source = "simulated";

    console.log("🔍 Simulating transaction...");

    // ✅ FIX: Use consistent asset identifier
    const assetName = selectedAsset.key || selectedAsset.nameKey?.replace('assets.', '') || selectedAsset.nameKey;
    
    console.log("🔍 Using asset name:", assetName);

    // Check for existing purchase
    const { data: existingRecords, error: fetchErr } = await supabase
      .from("presale_purchases")
      .select("*")
      .eq("user_id", session.user.id)
      .eq("asset_name", assetName);

    if (fetchErr) {
      console.error("❌ Fetch error:", fetchErr);
      throw new Error(`Database fetch failed: ${fetchErr.message}`);
    }

    const existing = existingRecords?.[0];
    console.log("🔍 Existing purchase found:", existing);

    let result;
    if (existing) {
      // Update existing purchase
      const prevHistory = existing.payment_history || [];
      const updatedHistory = [...prevHistory, {
        token: selectedToken,
        amount: totalUSD,
        date: new Date().toISOString(),
        quantity: quantity
      }];

      result = await supabase
        .from("presale_purchases")
        .update({
          quantity: (existing.quantity || 0) + quantity,
          total_usd: (existing.total_usd || 0) + totalUSD,
          payment_history: updatedHistory,
          source,
          latest_purchase_at: new Date().toISOString(),
          updated_at: new Date().toISOString()
        })
        .eq("id", existing.id);

    } else {
      // Create new purchase - MAKE SURE asset_key IS INCLUDED
      const newPurchase = {
        user_id: session.user.id,
        wallet_address: walletAddress,
        asset_name: assetName,
        asset_key: assetName, // ← THIS MUST BE INCLUDED
        asset_name_key: selectedAsset.nameKey,
        quantity: quantity,
        price_usd: usdPrice,
        total_usd: totalUSD,
        payment_token: selectedToken,
        payment_history: [{
          token: selectedToken,
          amount: totalUSD,
          date: new Date().toISOString(),
          quantity: quantity
        }],
        tx_signature: txSignature,
        source: source,
        created_at: new Date().toISOString(),
        latest_purchase_at: new Date().toISOString()
      };

      console.log("🔍 Inserting new purchase:", newPurchase);
      result = await supabase
        .from("presale_purchases")
        .insert([newPurchase]);
    }

    console.log("🔍 Database result:", result);

    if (result.error) {
      console.error("❌ Database error details:", {
        message: result.error.message,
        details: result.error.details,
        hint: result.error.hint,
        code: result.error.code
      });
      throw new Error(`Database error: ${result.error.message}`);
    }

    console.log("✅ Purchase recorded successfully");

    await supabase
   .from("presale_sessions")
   .update({ has_invested: true })
   .eq("user_id", session.user.id);

    setUserHasInvested(true);

       // Update balances
    if (selectedToken === "SOL") {
      const mockSolPrice = 150;
      setSolBalance((prev) => Math.max(0, (prev ?? 0) - totalUSD / mockSolPrice));
    } else if (selectedToken === "USDC") {
      setUsdcBalance((prev) => (prev || 0) - totalUSD);
    }

    // Refresh purchases
    const { data: updated, error: refreshError } = await supabase
      .from("presale_purchases")
      .select("*")
      .eq("user_id", session.user.id)
      .order("created_at", { ascending: false });

    if (refreshError) {
      console.error("Refresh error:", refreshError);
    } else {
      setPurchases(updated || []);
    }

    setShowModal(false);
    
    // ✅ FIX: Use translation for success message
    alert(t("success.purchase_success", { 
      quantity: quantity, 
      asset: t(selectedAsset.nameKey), 
      amount: totalUSD.toFixed(2) 
    }));

  } catch (err: any) {
    console.error("❌ Transaction failed:", err);
    // ✅ FIX: Use translation for error message
    alert(t("errors.transaction_failed", { message: err.message }));
  }
}
     
  // ------------------ REAL MARINE INVESTMENT VALUE CALCULATION ------------------
function calculateCurrentValue(purchase: any) {
  const base = purchase.total_usd || 0;
  if (base <= 0) return { value: 0, change: 0, displayValue: "$0.00" };

  const createdAt = new Date(purchase.created_at);
  const now = new Date();
  
  // --- Calculate time in years ---
  const diffMs = now.getTime() - createdAt.getTime();
  const diffYears = diffMs / (1000 * 60 * 60 * 24 * 365.25);

  // --- Marine industry specific annual ROI rates ---
  const marineROIRates = {
    portConcessions: 0.12,        // 12% annual - stable port operations
    dockingFees: 0.08,            // 8% annual - consistent fee income
    containerHandling: 0.15,      // 15% annual - growing trade volume
    logisticsInfrastructure: 0.18, // 18% annual - infrastructure appreciation
    straitPassageRights: 0.25,    // 25% annual - strategic premium
    portx: 0.30                   // 30% annual - technology innovation premium
  };

  // Extract asset type from purchase data
  const assetType = purchase.asset_name?.replace('assets.', '').replace('PresaleAssets.', '');
  const annualRate = marineROIRates[assetType as keyof typeof marineROIRates] || marineROIRates.portConcessions;
  
  // Compound annual growth (realistic marine investment returns)
  const currentValue = base * Math.pow(1 + annualRate, diffYears);
  
  const changePercent = ((currentValue - base) / base) * 100;

  return {
    value: currentValue,
    change: changePercent,
    displayValue: `$${currentValue.toLocaleString(undefined, {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    })}`,
  };
}

   const checkQuestionnaireStatus = async () => {
