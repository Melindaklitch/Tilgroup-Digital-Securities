   useEffect(() => {
     const initializeApp = async () => {
    try {
      setLoading(true);
      const { data, error } = await supabase.auth.getSession();
      
      if (error) {
        console.error('Auth error:', error);
        router.push('/signin');
        return;
      }
      
      if (!data.session) {
        router.push('/signin');
        return;
      }
      
      setSession(data.session);

      // ✅ Rest of your initialization code continues here...
      const { data: profile, error: profileError } = await supabase
        .from("profiles")
        .select("wallet_address")
        .eq("id", data.session.user.id)
        .maybeSingle();

      if (profileError) {
        console.error('Error fetching profile:', profileError);
      } else if (profile?.wallet_address) {
        setWalletAddress(profile.wallet_address);
        fetchBalances(profile.wallet_address);
      }    

      // ✅ Create missing records for old users
      const { data: existingProfile } = await supabase
        .from('profiles')
        .select('id')
        .eq('id', data.session.user.id)
        .maybeSingle();

      if (!existingProfile) {
        // Create profile record with proper error handling
        const { error: profileError } = await supabase
          .from('profiles')
          .insert({
            id: data.session.user.id,
            email: data.session.user.email,
            created_at: new Date().toISOString()
          });

        if (profileError) {
          console.error('Error creating profile:', profileError);
        } else {
          console.log('Created missing profile for old user');
        }
      }

      const { data: existingLegal } = await supabase
        .from('user_legal_status')
        .select('user_id')
        .eq('user_id', data.session.user.id)
        .maybeSingle();

      if (!existingLegal) {
        // Create legal_status record with proper error handling
        const { error: legalError } = await supabase
          .from('user_legal_status')
          .insert({
            user_id: data.session.user.id,
            fully_compliant: false,
            created_at: new Date().toISOString()
          });

        if (legalError) {
          console.error('Error creating legal status:', legalError);
        } else {
          console.log('Created missing legal status for old user');
        }
      }

      // ✅ Fetch user purchases
      const { data: userPurchases, error: purchasesError } = await supabase
        .from("presale_purchases")
        .select("*")
        .eq("user_id", data.session.user.id)
        .order("created_at", { ascending: false });

      if (purchasesError) {
        console.error('Error fetching purchases:', purchasesError);
        setPurchases([]);
      } else {
        setPurchases(userPurchases || []);
      }
      
    } catch (error) {
      console.error('Initialization failed:', error);
    } finally {
      setLoading(false);
    }
  };
  
  initializeApp();
}, [router, fetchBalances]);

