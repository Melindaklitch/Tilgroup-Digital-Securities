           {connected ? t("wallet.connected") : t("wallet.connecting")}
         </div>
         <div className={`flex items-center ${publicKey ? "text-green-400" : "text-yellow-400"}`}>
           <span className="w-2 h-2 rounded-full bg-current mr-2"></span>
           {publicKey ? t("wallet.public_key_received") : t("wallet.waiting_public_key")}
         </div>
       </div>
      
     {/* Enhanced retry options */}
         <div className="flex gap-3">
           <button
             onClick={() => {
               setWalletConnecting(true);
               setTimeout(() => setWalletConnecting(false), 3000);
             }}
             className="bg-portxGreen text-black px-4 py-2 rounded text-sm"
           >
             {t("wallet.retry_connection")}
           </button>
           <button
             onClick={() => typeof window !== 'undefined' && window.location.reload()}
             className="border border-gray-600 text-gray-300 px-4 py-2 rounded text-sm"
           >
             {t("wallet.refresh_page")}
           </button>
         </div>

         <p className="text-xs text-gray-500 mt-4">
           {t("presale.reconnect_wallet")}
         </p>
       </div>
     );
   }     

  if (!walletReady) {
    return (
      <div className="min-h-screen flex flex-col items-center justify-center bg-[#0a1f2f] text-white text-center px-6">
        <h1 className="text-3xl font-bold mb-3">
          {t("presale.connect_wallet")}
        </h1>
        <p className="text-gray-400 mb-6">
          {t("presale.connect_desc")}
        </p>

        {/* ✅ Wallet Connect Button */}
        <div className="bg-[#13283a] p-4 rounded-xl shadow-md">
          <WalletMultiButton />
        </div>

        <p className="text-xs text-gray-500 mt-4">
          {t("presale.wallet_hint") || "Make sure your wallet is set to Solana network."}
        </p>
      </div>
    );
   }
  console.log("🎯 RENDER GATE DEBUG:", {
  isCheckingQuestionnaire,
  userQuestionnaireCompleted,
  questionnaireStatus,
  hasSession: !!session?.user?.id
});

      // MAIN RETURN - PAGE CONTENT
  // ================= SAFE FINAL RENDER GATE =================
  let content;

  if (isCheckingQuestionnaire) {
    content = (
      <div className="min-h-screen flex items-center justify-center bg-[#071526] text-white">
        {t("success.loading")}
      </div>
    );
  } else if (questionnaireStatus === "pending") {
    content = (
      <div className="min-h-screen flex flex-col items-center justify-center p-6 bg-[#071526] text-white">
        <div className="max-w-md text-center space-y-6">
          <div className="text-5xl animate-pulse">⏳</div>
          <h1 className="text-2xl font-bold">{t("presale.protocol_processing")}</h1>
          <p className="text-gray-300">{t("presale.protocol_review")}</p>
        </div>
      </div>
    );
  } else if (!userQuestionnaireCompleted) {
    content = (
      <ExecutivePresaleProtocol
        userId={session?.user?.id}
        session={session}
        onComplete={(status) => {
          setQuestionnaireStatus(status);
          setQuestionnaireCompleted(true);
          setUserQuestionnaireCompleted(
            status === "qualified" || status === "priority"
          );
        }}
        onCancel={() => router.push("/")}
      />
    );
  } else {
    // ================= ORIGINAL PLATFORM DASHBOARD =================
    content = (
      <div className="min-h-screen bg-[#071526] text-white pt-20 p-6">
        <div className="max-w-7xl mx-auto space-y-6">
          {/* Header */}
          <header className="flex items-center justify-between">
            <div>
              <h1 className="text-2xl font-bold">{t("presale.title")}</h1>
              <div className="text-sm text-gray-300">
                {session?.user?.email} {" "}
                <span className="text-green-300">{walletAddress}</span>
              </div>
              <div className="text-xs text-gray-400 mt-1">
                {t("presale.balance")} : {(solBalance ?? 0).toFixed(3)} SOL |{" "}
                {(usdcBalance ?? 0).toFixed(2)} USDC
              </div>
            </div>
            <Button
              onClick={async () => {
                await supabase.auth.signOut();
                router.push("/signin");
              }}
              className="bg-red-600 text-white"
            >
              {t("common.disconnect")}
            </Button>
          </header>
    
          {/* --------------------------- EXECUTIVE PRESALE PROTOCOL --------------------------- */}
    <div className="bg-gradient-to-r from-blue-900/30 to-cyan-900/30 p-6 rounded-xl border border-cyan-500/20">
      <div className="text-center mb-4">
        <div className="inline-flex items-center justify-center p-2 bg-cyan-500/10 rounded-full mb-2">
          <span className="text-cyan-400 text-lg">⚡</span>
        </div>
        <h3 className="text-xl font-bold text-white">Executive Presale Protocol</h3>
        <p className="text-gray-300 text-sm">Priority Access • Institutional Grade</p>
      </div>
      
      <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
        {/* Metric 1: Average Investment Size */}
        <div className="bg-[#0a1f2f] p-4 rounded-lg border border-cyan-500/10">
          <div className="flex items-center justify-between">
            <div className="text-2xl font-bold text-cyan-400">$250K</div>
            <div className="text-cyan-400 text-sm bg-cyan-500/10 px-2 py-1 rounded">Avg</div>
          </div>
          <div className="text-xs text-gray-400 mt-1">Average Investment</div>
          <div className="text-xs text-cyan-300 mt-1">↑ 18% from last quarter</div>
        </div>
        
        {/* Metric 2: Institutional Participation */}
        <div className="bg-[#0a1f2f] p-4 rounded-lg border border-cyan-500/10">
          <div className="flex items-center justify-between">
            <div className="text-2xl font-bold text-cyan-400">42%</div>
            <div className="text-green-400 text-sm bg-green-500/10 px-2 py-1 rounded">Institutional</div>
          </div>
          <div className="text-xs text-gray-400 mt-1">Fund Participation</div>
          <div className="text-xs text-cyan-300 mt-1">VC & Family Offices</div>
        </div>
        
        {/* Metric 3: Allocation Completion */}
        <div className="bg-[#0a1f2f] p-4 rounded-lg border border-cyan-500/10">
          <div className="flex items-center justify-between">
            <div className="text-2xl font-bold text-cyan-400">$8.2M</div>
            <div className="text-green-400 text-sm bg-green-500/10 px-2 py-1 rounded">Allocated</div>
          </div>
          <div className="text-xs text-gray-400 mt-1">of $10M Round</div>
          <div className="w-full bg-gray-700 h-1.5 rounded-full mt-2">
            <div className="bg-gradient-to-r from-cyan-500 to-green-400 h-1.5 rounded-full" style={{ width: '82%' }}></div>
          </div>
        </div>
        
        {/* Metric 4: Accredited Investors */}
        <div className="bg-[#0a1f2f] p-4 rounded-lg border border-cyan-500/10">
          <div className="flex items-center justify-between">
            <div className="text-2xl font-bold text-cyan-400">100%</div>
            <div className="text-amber-400 text-sm bg-amber-500/10 px-2 py-1 rounded">Verified</div>
          </div>
          <div className="text-xs text-gray-400 mt-1">Accredited Status</div>
          <div className="text-xs text-amber-300 mt-1">KYC/AML Compliant</div>
        </div>
      </div>
      
      {/* Executive Protocol Status */}
      <div className="mt-4 pt-4 border-t border-cyan-500/10">
        <div className="flex items-center justify-between">
          <div className="flex items-center space-x-2">
            <div className="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
            <span className="text-sm text-gray-300">Your Protocol Status:</span>
          </div>
          <div className="flex items-center space-x-2">
            <span className="text-green-400 font-semibold">ACTIVE</span>
            <div className="text-xs bg-green-500/20 text-green-400 px-2 py-1 rounded">Priority Access</div>
          </div>
        </div>
        <div className="text-xs text-gray-400 mt-2">
          ✅ Executive protocol grants you priority allocation in all marine infrastructure offerings.
        </div>
      </div>
    </div>    


         {/* Questionnaire Status Banner */}
         {!questionnaireCompleted && (
            <div className="mt-2 p-2 bg-yellow-900/30 border border-yellow-700 rounded text-sm">
              <div className="flex items-center justify-between">
                <span className="text-yellow-300">
                  ⚠ Executive Protocol Required for Priority Access
                </span>
                <Button
                  size="sm"
                  className="bg-yellow-600 text-black text-xs"
                  onClick={() => setShowQuestionnaire(true)}
                >
                  Complete Protocol
                </Button>
              </div>
            </div>
          )}

        {/* ---------- ACTIVE PRESALE VIEW (for new users) ---------- */}

      {showLegalRequirements && (
        <div className="fixed inset-0 bg-black/80 flex items-center justify-center z-50">
          <div className="bg-[#0f2a3f] rounded-xl max-w-2xl w-full max-h-[80vh] overflow-y-auto">
            <div className="flex justify-between items-center mb-6">
              <h3 className="text-2xl font-bold">{t("legal.requirements")}</h3>
              <button
                
onClick={() => setShowLegalRequirements(false)}
                className="text-gray-400 hover:text-white text-2xl"
              >
                ×
              </button>
            </div>
            <p>{t("legal.required_before_viewing")}</p>
          </div>
        </div>
      )}

      {/* --------------------------- USER PRESALE INFO --------------------------- */}
      <div className="bg-[#072532] p-6 rounded-xl shadow">
        <h3 className="font-semibold mb-4">{t("presale.my_assets")}</h3>

        {purchases === undefined ? (
          <div className="text-gray-400">{t("presale.loading")}</div>
        ) : purchases.length === 0 ? (
          <div className="text-gray-400">{t("presale.no_assets")}</div>
        ) : (
          <>
            {/* ✅ Total Spent Summary */}
            <div className="flex items-center justify-between mb-3">
              <div className="text-sm text-gray-300">
                {t("presale.total_spent")}:
                <span className="text-green-400 font-semibold ml-2">
                  ${purchases.reduce((sum, p) => sum + (p.total_usd || 0), 0).toLocaleString()}
                </span>
              </div>
              <div className="text-xs text-gray-500">
                {purchases.length} {t("presale.assets_owned")}
              </div>
            </div>

            {/* Assets Table */}
            <div className="overflow-x-auto">
              <table className="min-w-full text-sm">
                <thead className="text-left text-gray-400">
                  <tr>
                    <th className="p-2">#</th>
                    <th className="p-2">{t("presale.asset")}</th>
                    <th className="p-2">{t("presale.quantity")}</th>
                    <th className="p-2">{t("presale.total")}</th>
                    <th className="p-2">{t("presale.token")}</th>
                    <th className="p-2">{t("presale.date")}</th>
                    <th className="p-2">{t("presale.action")}</th>
                  </tr>
                </thead>
                <tbody>
                  {purchases.map((p, idx) => {
                    const calc = calculateCurrentValue(p);
                    return (
                      <tr key={idx} className="border-t border-gray-800">
                        <td className="p-2">{idx + 1}</td>
                        <td className="p-2">
                          {translateAssetName(p.asset_name_key || p.asset_name, t)}
                        </td>
                        <td className="p-2">{p.quantity}</td>
                        <td className="p-2">
                          {calc.displayValue}
                          <span className={`ml-2 text-xs ${calc.change >= 0 ? "text-green-400" : "text-red-400"}`}>
                            {calc.change >= 0 ? "+" : ""}{calc.change.toFixed(2)}%
                          </span>
                        </td>
                        <td className="p-2"
                           title={(() => {
                           if (!p.payment_history) return "";
                           return p.payment_history
                           .map((h: any) => `${h.quantity} unit(s) - ${h.token}: $${h.amount} on ${new Date(h.date).toLocaleString()}`)
                           .join('\n');
                            })()}>
                          {p.payment_token}
                          {p.payment_history && p.payment_history.length > 1 && (
                            <span className="ml-1 text-xs text-gray-400">({p.payment_history.length} payments)</span>
                          )}
                        </td>
                        <td className="p-2">{new Date(p.latest_purchase_at || p.created_at).toLocaleString()}</td>
                        <td className="p-2">
                          <div className="flex gap-2">
                            <Button
                              size="sm"
                              className="bg-portxGreen text-black"
                              onClick={() => handleSellAsset(p)}
                            >
                              {t("presale.sell")}
                            </Button>
                          </div>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </>
        )}
      </div>

      {/* --------------------------- FEATURED ASSETS --------------------------- */}
      <div className="bg-[#072532] p-6 rounded-xl shadow">
        <h2 className="font-semibold mb-4">{t("presale.featured_assets")}</h2>
        <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
          {Object.keys(ASSETS_JSON).map((k) => {
            const a: any = (ASSETS_JSON as any)[k];
            return (
           <div
            key={k}
            className="bg-[#062b32] p-4 rounded-xl shadow-lg hover:shadow-xl transition cursor-pointer hover:border hover:border-portxGreen"
            onClick={() => requireLegal(() => handleShowAssetDetails(a, k))}
           >
                <div className="relative w-full h-40 rounded-lg mb-3">
                  <Image
                    src={a.image}
                    alt={t(a.nameKey)}
                    fill
                    className="object-cover rounded-lg"
                    sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
                  />
                </div>
                
                <div className="flex items-center justify-between mb-2">
                  <div className="font-semibold">{t(a.nameKey)}</div>
                  <div className="text-xs text-gray-400">{t(a.typeKey)}</div>
                </div>
                <div className="text-sm text-gray-300 mb-3">{t(a.spotlightKey)}</div>
                <div className="italic text-green-400 text-xs mb-3">
                  {t("presale.holder_benefit", { name: t(a.nameKey) })}
                </div>
                
                {/* Add "Learn More" button */}
                <div className="flex justify-between items-center mt-4">
                  <div className="text-lg font-bold text-green-400">
                    ${a.price.toLocaleString()}
                  </div>
                  <Button 
                    size="sm" 
                    className="bg-blue-600 text-white"
                    onClick={(e) => {
                     e.stopPropagation();
                     requireLegal(() => handleShowAssetDetails(a, k));
                   }}
                   >
                   {t("presale.learn_more")}
                   </Button>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      {/* --------------------------- MARKETPLACE --------------------------- */}
      <div className="bg-[#072532] p-6 rounded-xl shadow">
        <h3 className="font-semibold mb-4">{t("presale.marketplace_title")}</h3>
        <div className="overflow-x-auto">
          <table className="min-w-full text-sm">
            <thead className="text-left text-gray-400">
              <tr>
                <th className="p-2">#</th>
                <th className="p-2">{t("presale.asset")}</th>
                <th className="p-2">{t("presale.type")}</th>
                <th className="p-2">{t("presale.price")}</th>
                <th className="p-2">{t("presale.action")}</th>
              </tr>
            </thead>
            <tbody>
              {Object.keys(ASSETS_JSON).map((k, idx) => {
                const a: any = (ASSETS_JSON as any)[k];
                return (
                  <tr key={idx} className="border-t border-gray-800">
                    <td className="p-2">{idx + 1}</td>
                    <td className="p-2 font-medium">{t(a.nameKey)}</td>
                    <td className="p-2">{t(a.typeKey)}</td>
                    <td className="p-2">${a.price.toLocaleString()}</td>
                    <td className="p-2">
                    <Button
                      className="bg-portxGreen text-black"
                      onClick={() => 
                      requireLegal(() => {
                      handleJoinPresale(a);
                    })
                   }
                  >
                      {t("presale.join")}
                     </Button>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>

      {/* --------------------------- MODALS --------------------------- */}
      {showModal && selectedAsset && (
        <div className="fixed inset-0 bg-black/70 flex items-center justify-center z-50">
          <div className="bg-[#0f1f2f] p-6 rounded-xl w-full max-w-sm">
            <h2 className="text-lg font-bold mb-4">{t("presale.join")}</h2>
            <p className="mb-2">{t("presale.asset")}: <strong>{t(selectedAsset.nameKey)}</strong></p>
            <p className="mb-4">{t("presale.unit_price")}: <strong>${selectedAsset.price.toLocaleString()}</strong></p>

            <label className="block text-sm mb-1">{t("presale.quantity")}</label>
            <input
              type="number"
              min="1"
              value={selectedAsset.quantity || 1}
              onChange={(e) =>
                setSelectedAsset({
                  ...selectedAsset,
                  quantity: Number(e.target.value) || 1,
                })
              }
              className="w-full mb-4 p-2 rounded bg-[#071526] text-white"
            />

            <label className="block text-sm mb-1">{t("presale.pay_with")}</label>
            <select
              className="w-full p-2 rounded mb-4 bg-[#071526]"
              value={selectedToken}
              onChange={(e) => setSelectedToken(e.target.value)}
            >
              <option value="SOL">SOL</option>
              <option value="USDC">USDC</option>
            </select>

            {(() => {
              const q = selectedAsset.quantity || 1;
              const totalUSD = selectedAsset.price * q;
              const mockSolPrice = 150;
              const totalSOL = (totalUSD / mockSolPrice).toFixed(4);
              const totalUSDC = totalUSD.toFixed(2);

              return (
                <div className="mb-4 text-sm">
                  <p>{t("presale.total")}: <strong>${totalUSD.toLocaleString()}</strong></p>
                  <p>≈ {selectedToken === "SOL" ? `${totalSOL} SOL` : `${totalUSDC} USDC`}</p>
                </div>
              );
            })()}

            <div className="flex gap-2 justify-end">
              <Button onClick={() => setShowModal(false)}>{t("common.cancel")}</Button>
              <Button className="bg-portxGreen text-black" onClick={confirmTransaction}>{t("common.confirm")}</Button>
            </div>
          </div>
        </div>
      )}
      
      {/* Asset Detail Modal */}
<AssetDetailModal
  asset={selectedAssetDetail}
  isOpen={showAssetDetail}
  onClose={() => setShowAssetDetail(false)}
  onInvestNow={handleInvestFromDetails}
  onShowQuestionnaire={() => setShowQuestionnaire(true)} // NEW PROP
  t={t}
  userLegalCompliant={userLegalCompliant || legalAcknowledged}
  userQuestionnaireCompleted={userQuestionnaireCompleted}
  setUserLegalCompliant={setUserLegalCompliant}
  legalAcknowledged={legalAcknowledged}
  setLegalAcknowledged={setLegalAcknowledged}
  session={session}
/>
        {/* Add this toast component with your other modals */}
   {showPurchaseToast && latestPurchase && (
       <div className="fixed top-4 right-4 bg-green-600 text-white p-4 rounded-lg shadow-lg z-50 animate-bounce">
         <div className="flex items-center space-x-2">
           <div className="text-xl">🎉</div>
           <div>
             <div className="font-semibold">{t("toast.new_investment")}</div>
             <div className="text-sm">
               {t("toast.purchase_notification", { asset_name: latestPurchase.asset_name })}
             </div>
           </div>
         </div>
       </div>
     )}

    {showLegalModal && (
        <div className="fixed inset-0 bg-black/80 flex items-center justify-center z-50">
          <div className="bg-[#0f2a3f] rounded-xl max-w-2xl w-full max-h-[80vh] overflow-y-auto p-6">
            <div className="flex justify-between items-center mb-6">
              <h3 className="text-2xl font-bold">{t("legal.requirements")}</h3>
              <button 
                onClick={() => setShowLegalModal(false)}
                className="text-gray-400 hover:text-white text-2xl"
              >
                ×
              </button>
            </div>
            
            <div className="space-y-4">
              <div className="flex justify-between items-center p-4 bg-[#071526] rounded-lg border border-gray-700">
                <div className="flex items-center space-x-4">
                  <div className="bg-yellow-500 p-2 rounded">📄</div>
                  <div>
                    <h4 className="font-semibold text-white">{t("legal.token_purchase_agreement")}</h4>
                    <p className="text-sm text-gray-400">{t("legal.required_for_all_investments")}</p>
                  </div>
                </div>
                <Button
                  variant="outline"
                  size="sm"
                  onClick={() =>
                 typeof window !== "undefined" &&
                 window.open("/legal/documents/token-purchase-agreement.pdf", "_blank")
               }
                >
                  {t("common.view_pdf") || "View PDF"}
                </Button>
              </div>
            </div>
            
            <div className="mt-6 p-4 bg-[#071526] rounded-lg">
              <div className="flex items-center space-x-3">
                                 <input 
                    type="checkbox" 
                    id="legal-acknowledge" 
                    className="w-4 h-4"
                    onChange={async (e) => {
                      if (e.target.checked && session?.user?.id) {
                        try {
                          // 1. Save to legal_acknowledgements table
                          const { error: ackError } = await supabase
                            .from('legal_acknowledgements')
                            .upsert({
                              user_id: session.user.id,
                              document_type: 'token_purchase_agreement',
                              acknowledged: true,
                              acknowledged_at: new Date().toISOString()
                            }, {
                              onConflict: 'user_id,document_type'
                            });

                          if (ackError) {
                            console.error("❌ Error saving legal acknowledgement:", ackError);
                            alert("Failed to save legal acknowledgment. Please try again.");
                            return;
                          }

                          console.log('✅ Legal acknowledgement saved successfully');
                          
                          // 2. Update user_legal_status to mark as fully compliant
                          const { error: statusError } = await supabase
                            .from('user_legal_status')
                            .upsert({
                              user_id: session.user.id,
                              fully_compliant: true,
                              updated_at: new Date().toISOString()
                            }, {
                              onConflict: 'user_id'
                            });

                          if (statusError) {
                            console.error("❌ Error updating legal status:", statusError);
                          } else {
                            console.log('✅ User legal status updated to compliant');
                          }

                          // 3. Update local state immediately
                          setUserLegalCompliant(true);
                          setLegalAcknowledged(true);
                          setShowLegalModal(false);
                          
                          console.log('🎉 Legal process completed successfully');

                        } catch (err) {
                          console.error('❌ Failed to save legal acknowledgement:', err);
                          alert('An error occurred while saving your acknowledgment. Please try again.');
                        }
                      }
                    }}
                  />
                 <label htmlFor="legal-acknowledge" className="text-sm text-gray-300">
               {t("legal.acknowledgment_points.read_documents")}
                </label>
              </div>
            </div>
          </div>
         </div>
        )}
     </div>
   </div>
  );
 }

return <>{content}</>;

}
