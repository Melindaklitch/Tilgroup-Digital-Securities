  function AssetDetailModal({ 
  asset, 
  isOpen, 
  onClose, 
  t, 
  onInvestNow,
  onShowQuestionnaire,
  userLegalCompliant,
  userQuestionnaireCompleted,
  setUserLegalCompliant,
  legalAcknowledged,
  setLegalAcknowledged,
  session
}: {
  asset: any;
  isOpen: boolean;
  onClose: () => void;
  t: (key: string) => string;
  onInvestNow: (asset: any) => void;
  userLegalCompliant: boolean;
  onShowQuestionnaire: () => void;
  userQuestionnaireCompleted: boolean;
  setUserLegalCompliant: (value: boolean) => void;
  legalAcknowledged: boolean;
  setLegalAcknowledged: (value: boolean) => void;
  session: any;
}) {
  if (!isOpen || !asset) return null;
  
  const [showAssetDetails, setShowAssetDetails] = useState(userLegalCompliant);  

  // Investment data for each asset type
  const investmentDetails: { [key: string]: {
    roi: string;
    timeline: string;
    risk: string;
    minInvestment: string;
    descriptionKey: string;
    benefits: string[];
    financialProjection?: { // ← MAKE OPTIONAL with ?
      [key: string]: string;
    };
  } } = {
    portConcessions: {
      roi: "12-18%",
      timeline: "5_10_years",
      risk: "medium",    
      minInvestment: "$50,000",
      descriptionKey: "presale.portConcessions.detailed_desc",
      benefits: [
        "presale.benefits.revenue_sharing",
        "presale.benefits.portfolio_diversification",
        "presale.benefits.long_term_income"
      ],
      financialProjection: {
        year1: "8%",
        year3: "12%",
        year5: "15%",
        year10: "18%"
      }
    },
    dockingFees: {
      roi: "8-12%",
      timeline: "2_5_years", 
      risk: "low",
      minInvestment: "$15,000",
      descriptionKey: "presale.dockingFees.detailed_desc",
      benefits: [
        "presale.benefits.stable_income",
        "presale.benefits.monthly_payouts",
        "presale.benefits.low_volatility"
      ],
      financialProjection: {
        year1: "6%",
        year2: "7%",
        year3: "8%",
        year5: "10%"
      } 
    },
    containerHandling: {
      roi: "10-15%",
      timeline: "5_10_years",               
      risk: "low",
      minInvestment: "$22,000",
      descriptionKey: "presale.containerHandling.detailed_desc",
      benefits: [
        "presale.benefits.revenue_sharing",
        "presale.benefits.operational_income",
        "presale.benefits.growth_potential"
      ]
      // No financialProjection - that's OK now
    },
    logisticsInfrastructure: {
      roi: "15-25%",
      timeline: "5_10_years",
      risk: "medium",
      minInvestment: "$100,000",
      descriptionKey: "presale.logisticsInfrastructure.detailed_desc",
      benefits: [
        "presale.benefits.infrastructure_ownership",
        "presale.benefits.long_term_appreciation",
        "presale.benefits.strategic_asset"
      ]
      // No financialProjection
    },
    straitPassageRights: {
      roi: "20-30%",
      timeline: "3_7_years",
      risk: "medium",
      minInvestment: "$25,000",
      descriptionKey: "presale.straitPassageRights.detailed_desc",
      benefits: [
        "presale.benefits.exclusive_rights",
        "presale.benefits.high_margin",
        "presale.benefits.strategic_position"
      ]
      // No financialProjection
    },
    portx: {
      roi: "25-40%",
      timeline: "2_5_years",
      risk: "high",
      minInvestment: "$2,500",
      descriptionKey: "presale.portx.detailed_desc",
      benefits: [
        "presale.benefits.technology_upside",
        "presale.benefits.rapid_growth",
        "presale.benefits.innovation_leadership"
      ]
      // No financialProjection
    }
  };

  const details = investmentDetails[asset.key as keyof typeof investmentDetails] || investmentDetails.portx;

  const handleLegalAcknowledgment = async () => {
    if (legalAcknowledged && session?.user?.id) {
      try {
        console.log("📝 Saving legal acknowledgment for user:", session.user.id);
        
        // 1. First save to legal_acknowledgements table
        const { error: ackError } = await supabase
          .from('legal_acknowledgements')
          .upsert({
            user_id: session.user.id,
            document_type: 'token_purchase_agreement',
            acknowledged: true,
            acknowledged_at: new Date().toISOString()
          }, {
            onConflict: 'user_id,document_type'
          });

        if (ackError) {
          console.error('❌ Error saving legal acknowledgement:', ackError);
          alert('Failed to save legal acknowledgment. Please try again.');
          return;
        }

        console.log('✅ Legal acknowledgement saved successfully');
        
        // 2. Then update user_legal_status to mark as fully compliant
        const { error: statusError } = await supabase
          .from('user_legal_status')
          .upsert({
            user_id: session.user.id,
            fully_compliant: true,
            updated_at: new Date().toISOString()
          }, {
            onConflict: 'user_id'
          });

        if (statusError) {
          console.error('❌ Error updating legal status:', statusError);
        } else {
          console.log('✅ User legal status updated to compliant');
        }

        // 3. Update local state immediately
        setUserLegalCompliant(true);
        setShowAssetDetails(true);
        
        console.log('🎉 Legal process completed successfully');

      } catch (err) {
        console.error('❌ Failed to save legal acknowledgement:', err);
        alert('An error occurred while saving your acknowledgment. Please try again.');
      }
    } else {
      console.log('⚠ Cannot save legal acknowledgment - missing data:', {
        legalAcknowledged,
        hasSession: !!session,
        userId: session?.user?.id
      });
    }
  };
  
 const handleInvestClick = () => {
  if (!userQuestionnaireCompleted) {
    onShowQuestionnaire();
    return;
  }

  // Legal compliance is now handled by requireLegal()
  onInvestNow(asset);
}; 

  // ASSET DETAILS VIEW (only shown after legal acknowledgment)
  return (
    <div className="fixed inset-0 bg-black/80 flex items-center justify-center z-50">
      <div className="bg-[#0f2a3f] rounded-xl max-w-4xl w-full max-h-[90vh] overflow-y-auto">
        {/* Header */}
        <div className="p-6 border-b border-gray-700">
          <div className="flex justify-between items-start">
            <div>
              <h2 className="text-2xl font-bold">{t(asset.nameKey)}</h2>
              <p className="text-gray-300">{t(asset.typeKey)}</p>
            </div>
            <button
              onClick={onClose}
              className="text-gray-400 hover:text-white text-2xl"
            >
              ×
            </button>
          </div>
        </div>

        <div className="p-6 space-y-6">
          {/* Asset Image */}
          <div className="relative w-full h-64 rounded-lg overflow-hidden">
            <Image
              src={asset.image}
              alt={t(asset.nameKey)}
              fill
              className="object-cover"
            />
          </div>

          {/* Spotlight Text */}
          <div className="bg-[#071526] p-4 rounded-lg">
            <p className="text-gray-300 italic">"{t(asset.spotlightKey)}"</p>
          </div>

          {/* Physical Details */}
          <div className="bg-[#071526] p-4 rounded-lg">
            <h3 className="font-semibold text-lg mb-3">{t("asset_details.physical_details")}</h3>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
              {asset.physicalDetails && Object.entries(asset.physicalDetails).map(([key, value]) => (
                <div key={key} className="flex justify-between border-b border-gray-700 pb-2">
                  <span className="text-gray-400 capitalize">
                    {t(`assetFieldLabels.${key}`)}:
                  </span>
                  <span className="text-white text-right">
                    {t(value as string)}
                  </span>
                </div>
              ))}
            </div>
          </div>

          {/* Investment Details */}
          <div className="bg-[#071526] p-4 rounded-lg">
            <h3 className="font-semibold text-lg mb-3">{t("asset_details.investment_details")}</h3>
            <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
              <div className="text-center">
                <div className="text-2xl font-bold text-portxGreen">{details.roi}</div>
                <div className="text-sm text-gray-400">{t("asset_details.annual_roi")}</div>
              </div>
              <div className="text-center">
                <div className="text-2xl font-bold text-portxGreen">{details.minInvestment}</div>
                <div className="text-sm text-gray-400">{t("asset_details.min_investment")}</div>
              </div>
              <div className="text-center">
                <div className="text-2xl font-bold text-portxGreen">{t(`success.timelines.${details.timeline}`)}</div>
                <div className="text-sm text-gray-400">{t("asset_details.timeline")}</div>
              </div>
              <div className="text-center">
                <div className="text-2xl font-bold text-portxGreen capitalize">{t(`success.risk_levels.${details.risk}`)}</div>
                <div className="text-sm text-gray-400">{t("asset_details.risk_level")}</div>
              </div>
            </div>

            {/* Benefits */}
            <div className="mb-4">
              <h4 className="font-semibold mb-2">{t("asset_details.benefits")}</h4>
              <ul className="list-disc list-inside space-y-1 text-gray-300">
                {details.benefits.map((benefit: string, index: number) => (
                  <li key={index}>{t(benefit)}</li>
                ))}
              </ul>
            </div>

            {/* Financial Projection */}
            {details.financialProjection && Object.keys(details.financialProjection).length > 0 && (
              <div>
                <h4 className="font-semibold mb-2">{t("presale.financial_projection")}:</h4>
                <div className="grid grid-cols-2 md:grid-cols-4 gap-2 text-sm">
                  {Object.entries(details.financialProjection).map(([year, value]) => (
                    <div key={year} className="text-center bg-[#062b32] p-2 rounded">
                      <div className="font-semibold">{value as string}</div>
                      <div className="text-gray-400"> {t(`financialProjection.${year}`)}</div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* Invest Button */}
            <div className="flex justify-end space-x-3">
              <Button
                variant="outline"
                onClick={() => setShowAssetDetails(false)}
              >
                {t("asset_details.back_to_legal")}
              </Button>
              <Button
                className="bg-portxGreen text-black px-8 py-2 text-lg"
                onClick={handleInvestClick}
              >
                {t("presale.invest_now")}
              </Button>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}
 
  export default function PlatformPage() {
  const { connection } = useConnection();
  const { t, i18n } = useTranslation(); 
  const { connected, publicKey } = useWallet();
  const router = useRouter();

  
  // State declarations
  const PRESALE_GOAL = 200;
  const [userPresaleStart, setUserPresaleStart] = useState<Date | null>(null);
  const [virtualInvestors, setVirtualInvestors] = useState(0);
  const [userHasInvested, setUserHasInvested] = useState(false);
  const [session, setSession] = useState<any>(null);
  const [walletAddress, setWalletAddress] = useState<string | null>(null);
  const [solBalance, setSolBalance] = useState<number | null>(null);
  const [isCheckingQuestionnaire, setIsCheckingQuestionnaire] = useState(true);
  const [usdcBalance, setUsdcBalance] = useState<number | null>(null);
  const [purchases, setPurchases] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [userQuestionnaireCompleted, setUserQuestionnaireCompleted] = useState(false);
  const [showQuestionnaire, setShowQuestionnaire] = useState(false);
  const [userQuestionnaireStatus, setUserQuestionnaireStatus] = useState<any>(null);
  const [walletConnecting, setWalletConnecting] = useState(true);
  const [showModal, setShowModal] = useState(false);
  const [selectedAsset, setSelectedAsset] = useState<any>(null);
  const [selectedToken, setSelectedToken] = useState("SOL");
  const [showAssetDetail, setShowAssetDetail] = useState(false);
  const [selectedAssetDetail, setSelectedAssetDetail] = useState<any>(null);
  const [recentPurchases, setRecentPurchases] = useState<any[]>([]);
  const [presaleEnded, setPresaleEnded] = useState(false);
  const [showPurchaseToast, setShowPurchaseToast] = useState(false);
  const [latestPurchase, setLatestPurchase] = useState<any>(null);
  

 const [questionnaireCompleted, setQuestionnaireCompleted] = useState(false);
 const [questionnaireStatus, setQuestionnaireStatus] = useState<'not_started' | 'pending' | 'qualified' | 'rejected'>('not_started');   
 const [hasShownQuestionnaire, setHasShownQuestionnaire] = useState(false);


 // Legal compliance state
  const [userLegalStatus, setUserLegalStatus] = useState<any>(null);
  const [showLegalModal, setShowLegalModal] = useState(false);
  const [legalAcknowledged, setLegalAcknowledged] = useState(false);
  const [showLegalRequirements, setShowLegalRequirements] = useState(false);

// Helper function to verify and sync wallet state
const verifyWalletState = () => {
  if (typeof window === 'undefined') return false;
  
  const phantom = window.phantom?.solana;
  if (!phantom?.isPhantom) {
    console.log("⚠ verifyWalletState: Phantom not found");
    return false;
  }
  
  console.log("🔎 [Verify] Current state comparison:", {
    phantomConnected: phantom.isConnected,
    phantomPublicKey: phantom.publicKey?.toString(),
    appConnected: connected,
    appPublicKey: publicKey?.toString(),
    timestamp: new Date().toISOString()
  });
  
  // If states don't match, log warning
  if (phantom.isConnected !== connected) {
    console.warn("🚨 [Verify] STATE MISMATCH DETECTED!", {
      phantom: phantom.isConnected ? "connected" : "disconnected",
      app: connected ? "connected" : "disconnected",
      action: "Check connection logic"
    });
    
    // You could auto-correct here if needed
    if (phantom.isConnected && !connected) {
      console.log("🔄 [Verify] Auto-correcting: Setting app to connected");
      // setConnected(true);
    }
  }
  
  return phantom.isConnected === connected; // Returns true if states match
};

 useEffect(() => {
  const initPresaleSession = async () => {
    if (!session?.user?.id) return;
  
    try {
      // Check if presale session exists
      const { data, error } = await supabase
        .from("presale_sessions")
        .select("*")
        .eq("user_id", session.user.id)
        .maybeSingle();
  
      if (error) {
        console.error("❌ SELECT presale_sessions failed:", error);
        return;
      }
  
      // Create session if it doesn't exist
      if (!data) {
        const { error: insertError } = await supabase
          .from("presale_sessions")
          .insert({
            user_id: session.user.id,
            presale_start_at: new Date().toISOString()
          });
  
        if (insertError) {
          console.error("❌ INSERT presale_sessions failed:", insertError);
          return;
        }
        
        console.log("✅ Presale session created");
        setUserHasInvested(false);
        setVirtualInvestors(196);
        setUserPresaleStart(new Date());
        return;
      }
      
      // If session exists, set states from data
      setUserPresaleStart(new Date(data.presale_start_at || data.started_at));
      setVirtualInvestors(data.virtual_investors || 196);
      setUserHasInvested(data.has_invested || false);
      setPresaleEnded(false);
      
    } catch (err) {
      console.error("❌ initPresaleSession error:", err);
    }
  };

  initPresaleSession();
 }, [session?.user?.id]);
 
  useEffect(() => {
  console.log("🔍 Running checkQuestionnaireStatus...");
  checkQuestionnaireStatus();
  }, [session?.user?.id]);

 // ================== QUESTIONNAIRE STATUS MANAGEMENT ==================
useEffect(() => {
  if (!session?.user?.id || loading) return;
    console.log("🔍 Checking questionnaire status for user:", session.user.id);
  
  const checkQuestionnaire = async () => {
    const { data, error } = await supabase
      .from('executive_presale_protocols')
      .select('protocol_status, submitted_at, verified_at')
      .eq('user_id', session.user.id)
      .maybeSingle();
    
    if (error) {
      console.error("❌ Error checking questionnaire:", error);
      return;
    }
    
    console.log("📊 Questionnaire data:", data);
    
    const hasQuestionnaire = !!data;
    const isSubmitted = !!data?.submitted_at;
    const isVerified = !!data?.verified_at;
    const status = data?.protocol_status || 'not_started';
    
    console.log("📋 Status analysis:", {
      hasQuestionnaire,
      isSubmitted,
      isVerified,
      status
    });
    
    // Update states
    setQuestionnaireCompleted(isSubmitted);
    setQuestionnaireStatus(status);
    
    // CRITICAL FIX: User is questionnaire completed if status is 'approved'
    // OR if they have verified_at timestamp (already approved)
    const isApproved = ['qualified', 'priority'].includes(status) || isVerified;
    setUserQuestionnaireCompleted(isApproved);
    
    // Show questionnaire if new user hasn't started
    if (!hasQuestionnaire && !isSubmitted && !hasShownQuestionnaire) {
      console.log("📋 Showing questionnaire for new user");
      setShowQuestionnaire(true);
      setHasShownQuestionnaire(true);
    }
  };
  
  checkQuestionnaire();
}, [session?.user?.id, hasShownQuestionnaire]);

// ================== REAL-TIME STATUS POLLING ==================
   
 useEffect(() => {
  if (!session?.user?.id) return;

  let pollInterval: NodeJS.Timeout | null = null;

  const pollStatus = async () => {
    const { data } = await supabase
      .from('executive_presale_protocols')
      .select('protocol_status, verified_at, submitted_at')
      .eq('user_id', session.user.id)
      .maybeSingle();

    if (data?.protocol_status === 'qualified' || data?.protocol_status === 'priority' || data?.verified_at) {
      setQuestionnaireStatus('qualified');
      setUserQuestionnaireCompleted(true);
      setQuestionnaireCompleted(true);

      if (pollInterval) clearInterval(pollInterval);
    }
  };

  if (questionnaireStatus === 'pending') {
    pollStatus();
    pollInterval = setInterval(pollStatus, 30000);
  }

  return () => {
    if (pollInterval) clearInterval(pollInterval);
  };
}, [questionnaireStatus, session?.user?.id]);

// ===============================================================

  // ✅ Check and store legal acknowledgement status
 const [userLegalCompliant, setUserLegalCompliant] = useState(false);
 const hasLegalAccess = userLegalCompliant === true;

    useEffect(() => {
     if (recentPurchases.length > 0 && recentPurchases[0] !== latestPurchase) {
      setLatestPurchase(recentPurchases[0]);
      setShowPurchaseToast(true);
         
