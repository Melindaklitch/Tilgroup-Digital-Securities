  1430       async function confirmTransaction() {
  1431    if (!walletAddress || !selectedAsset || !session?.user?.id) {
  1432      alert(t("errors.missing_information")); // Use translation
  1433      return;
  1434    }
  1435
  1436    try {
  1437      const usdPrice = selectedAsset.price;
  1438      const quantity = selectedAsset.quantity || 1;
  1439      const totalUSD = usdPrice * quantity;
  1440      
  1441      console.log("🔍 Transaction Debug:", { 
  1442        selectedToken, 
  1443        totalUSD, 
  1444        asset: selectedAsset,
  1445        assetKey: selectedAsset.key,
  1446        assetNameKey: selectedAsset.nameKey 
  1447      });
  1448
  1449      // Balance checks with proper error messages
  1450      if (selectedToken === "SOL") {
  1451        const mockSolPrice = 150;
  1452        const solRequired = totalUSD / mockSolPrice;
  1453        if ((solBalance || 0) < solRequired) {
  1454          alert(t("errors.insufficient_balance", { 
  1455            token: "SOL", 
  1456            required: solRequired.toFixed(4) 
  1457          }));
  1458          return;
  1459        }
  1460      } else if (selectedToken === "USDC") {
  1461        if ((usdcBalance || 0) < totalUSD) {
  1462          alert(t("errors.insufficient_balance", { 
  1463            token: "USDC", 
  1464            required: totalUSD.toFixed(2) 
  1465          }));
  1466          return;
  1467        }
  1468      }
  1469
  1470      // SIMULATE TRANSACTION
  1471      let txSignature = `simulated-${selectedToken.toLowerCase()}-${Date.now()}`;
  1472      let source = "simulated";
  1473
  1474      console.log("🔍 Simulating transaction...");
  1475
  1476      // ✅ FIX: Use consistent asset identifier
  1477      const assetName = selectedAsset.key || selectedAsset.nameKey?.replace('assets.', '') || selectedAsset.nameKey;
  1478      
  1479      console.log("🔍 Using asset name:", assetName);
  1480
  1481      // Check for existing purchase
  1482      const { data: existingRecords, error: fetchErr } = await supabase
  1483        .from("presale_purchases")
  1484        .select("*")
  1485        .eq("user_id", session.user.id)
  1486        .eq("asset_name", assetName);
  1487
  1488      if (fetchErr) {
  1489        console.error("❌ Fetch error:", fetchErr);
  1490        throw new Error(`Database fetch failed: ${fetchErr.message}`);
  1491      }
  1492
  1493      const existing = existingRecords?.[0];
  1494      console.log("🔍 Existing purchase found:", existing);
  1495
  1496      let result;
  1497      if (existing) {
  1498        // Update existing purchase
  1499        const prevHistory = existing.payment_history || [];
  1500        const updatedHistory = [...prevHistory, {
  1501          token: selectedToken,
  1502          amount: totalUSD,
  1503          date: new Date().toISOString(),
  1504          quantity: quantity
  1505        }];
  1506
  1507        result = await supabase
  1508          .from("presale_purchases")
  1509          .update({
  1510            quantity: (existing.quantity || 0) + quantity,
  1511            total_usd: (existing.total_usd || 0) + totalUSD,
  1512            payment_history: updatedHistory,
  1513            source,
  1514            latest_purchase_at: new Date().toISOString(),
  1515            updated_at: new Date().toISOString()
  1516          })
  1517          .eq("id", existing.id);
  1518
  1519      } else {
  1520        // Create new purchase - MAKE SURE asset_key IS INCLUDED
  1521        const newPurchase = {
  1522          user_id: session.user.id,
  1523          wallet_address: walletAddress,
  1524          asset_name: assetName,
  1525          asset_key: assetName, // ← THIS MUST BE INCLUDED
  1526          asset_name_key: selectedAsset.nameKey,
  1527          quantity: quantity,
  1528          price_usd: usdPrice,
  1529          total_usd: totalUSD,
  1530          payment_token: selectedToken,
  1531          payment_history: [{
  1532            token: selectedToken,
  1533            amount: totalUSD,
  1534            date: new Date().toISOString(),
  1535            quantity: quantity
  1536          }],
  1537          tx_signature: txSignature,
  1538          source: source,
  1539          created_at: new Date().toISOString(),
  1540          latest_purchase_at: new Date().toISOString()
  1541        };
  1542
  1543        console.log("🔍 Inserting new purchase:", newPurchase);
  1544        result = await supabase
  1545          .from("presale_purchases")
  1546          .insert([newPurchase]);
  1547      }
  1548
  1549      console.log("🔍 Database result:", result);
  1550
  1551      if (result.error) {
  1552        console.error("❌ Database error details:", {
  1553          message: result.error.message,
  1554          details: result.error.details,
  1555          hint: result.error.hint,
  1556          code: result.error.code
  1557        });
  1558        throw new Error(`Database error: ${result.error.message}`);
  1559      }
  1560
  1561      console.log("✅ Purchase recorded successfully");
  1562
  1563      await supabase
  1564     .from("presale_sessions")
  1565     .update({ has_invested: true })
  1566     .eq("user_id", session.user.id);
  1567
  1568      setUserHasInvested(true);
  1569
  1570         // Update balances
  1571      if (selectedToken === "SOL") {
  1572        const mockSolPrice = 150;
  1573        setSolBalance((prev) => Math.max(0, (prev ?? 0) - totalUSD / mockSolPrice));
  1574      } else if (selectedToken === "USDC") {
  1575        setUsdcBalance((prev) => (prev || 0) - totalUSD);
  1576      }
  1577
  1578      // Refresh purchases
  1579      const { data: updated, error: refreshError } = await supabase
  1580        .from("presale_purchases")
  1581        .select("*")
  1582        .eq("user_id", session.user.id)
  1583        .order("created_at", { ascending: false });
  1584
  1585      if (refreshError) {
  1586        console.error("Refresh error:", refreshError);
  1587      } else {
  1588        setPurchases(updated || []);
  1589      }
  1590
  1591      setShowModal(false);
  1592      
  1593      // ✅ FIX: Use translation for success message
  1594      alert(t("success.purchase_success", { 
  1595        quantity: quantity, 
  1596        asset: t(selectedAsset.nameKey), 
  1597        amount: totalUSD.toFixed(2) 
  1598      }));
  1599
  1600    } catch (err: any) {
  1601      console.error("❌ Transaction failed:", err);
  1602      // ✅ FIX: Use translation for error message
  1603      alert(t("errors.transaction_failed", { message: err.message }));
  1604    }
  1605  }
