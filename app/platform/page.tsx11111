  1607    // ------------------ REAL MARINE INVESTMENT VALUE CALCULATION ------------------
  1608  function calculateCurrentValue(purchase: any) {
  1609    const base = purchase.total_usd || 0;
  1610    if (base <= 0) return { value: 0, change: 0, displayValue: "$0.00" };
  1611
  1612    const createdAt = new Date(purchase.created_at);
  1613    const now = new Date();
  1614    
  1615    // --- Calculate time in years ---
  1616    const diffMs = now.getTime() - createdAt.getTime();
  1617    const diffYears = diffMs / (1000 * 60 * 60 * 24 * 365.25);
  1618
  1619    // --- Marine industry specific annual ROI rates ---
  1620    const marineROIRates = {
  1621      portConcessions: 0.12,        // 12% annual - stable port operations
  1622      dockingFees: 0.08,            // 8% annual - consistent fee income
  1623      containerHandling: 0.15,      // 15% annual - growing trade volume
  1624      logisticsInfrastructure: 0.18, // 18% annual - infrastructure appreciation
  1625      straitPassageRights: 0.25,    // 25% annual - strategic premium
  1626      portx: 0.30                   // 30% annual - technology innovation premium
  1627    };
  1628
  1629    // Extract asset type from purchase data
  1630    const assetType = purchase.asset_name?.replace('assets.', '').replace('PresaleAssets.', '');
  1631    const annualRate = marineROIRates[assetType as keyof typeof marineROIRates] || marineROIRates.portConcessions;
  1632    
  1633    // Compound annual growth (realistic marine investment returns)
  1634    const currentValue = base * Math.pow(1 + annualRate, diffYears);
  1635    
  1636    const changePercent = ((currentValue - base) / base) * 100;
  1637
  1638    return {
  1639      value: currentValue,
  1640      change: changePercent,
  1641      displayValue: `$${currentValue.toLocaleString(undefined, {
  1642        minimumFractionDigits: 2,
  1643        maximumFractionDigits: 2,
  1644      })}`,
  1645    };
  1646  }
