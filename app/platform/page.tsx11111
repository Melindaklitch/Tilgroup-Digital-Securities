  1051   const fetchBalances = React.useCallback(async (pubkeyStr: string) => {
  1052      if (TEST_MODE) {
  1053        setSolBalance(10000);
  1054        setUsdcBalance(5000);
  1055        return;
  1056      }
  1057
  1058      try {
  1059        const pubkey = new PublicKey(pubkeyStr);
  1060        const lamports = await connection.getBalance(pubkey);
  1061        setSolBalance(lamports / LAMPORTS_PER_SOL);
  1062
  1063        const resp = await connection.getParsedTokenAccountsByOwner(pubkey, {
  1064          programId: new PublicKey(
  1065            "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA"
  1066          ),
  1067        });
  1068
  1069             let usdcAmt = 0;
  1070       resp.value.forEach((acc) => {
  1071       const parsed = acc.account.data as ParsedAccountData;
  1072          const info: any = parsed.parsed?.info;
  1073          if (info?.mint === TOKENS[1].mint) {
  1074            usdcAmt = info.tokenAmount?.uiAmount ?? 0;
  1075          }
  1076        });
  1077        setUsdcBalance(usdcAmt);
  1078      } catch (err) {
  1079        console.error("Balance fetch failed", err);
  1080      }
  1081    }, [connection, TEST_MODE]); // ✅ Add dependencies
