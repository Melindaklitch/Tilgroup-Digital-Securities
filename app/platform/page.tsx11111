   294    const details = investmentDetails[asset.key as keyof typeof investmentDetails] || investmentDetails.portx;
   295
   296    const handleLegalAcknowledgment = async () => {
   297      if (legalAcknowledged && session?.user?.id) {
   298        try {
   299          console.log("📝 Saving legal acknowledgment for user:", session.user.id);
   300          
   301          // 1. First save to legal_acknowledgements table
   302          const { error: ackError } = await supabase
   303            .from('legal_acknowledgements')
   304            .upsert({
   305              user_id: session.user.id,
   306              document_type: 'token_purchase_agreement',
   307              acknowledged: true,
   308              acknowledged_at: new Date().toISOString()
   309            }, {
   310              onConflict: 'user_id,document_type'
   311            });
   312
   313          if (ackError) {
   314            console.error('❌ Error saving legal acknowledgement:', ackError);
   315            alert('Failed to save legal acknowledgment. Please try again.');
   316            return;
   317          }
   318
   319          console.log('✅ Legal acknowledgement saved successfully');
   320          
   321          // 2. Then update user_legal_status to mark as fully compliant
   322          const { error: statusError } = await supabase
   323            .from('user_legal_status')
   324            .upsert({
   325              user_id: session.user.id,
   326              fully_compliant: true,
   327              updated_at: new Date().toISOString()
   328            }, {
   329              onConflict: 'user_id'
   330            });
   331
   332          if (statusError) {
   333            console.error('❌ Error updating legal status:', statusError);
   334          } else {
   335            console.log('✅ User legal status updated to compliant');
   336          }
   337
   338          // 3. Update local state immediately
   339          setUserLegalCompliant(true);
   340          setShowAssetDetails(true);
   341          
   342          console.log('🎉 Legal process completed successfully');
   343
   344        } catch (err) {
   345          console.error('❌ Failed to save legal acknowledgement:', err);
   346          alert('An error occurred while saving your acknowledgment. Please try again.');
   347        }
   348      } else {
   349        console.log('⚠ Cannot save legal acknowledgment - missing data:', {
   350          legalAcknowledged,
   351          hasSession: !!session,
   352          userId: session?.user?.id
   353        });
   354      }
   355    };
   356    
   357    const handleInvestClick = () => {
   358    if (!userQuestionnaireCompleted) {
   359      onShowQuestionnaire();
   360      return;
   361    }
   362
   363    if (!userLegalCompliant) {
   364      setShowLegalModal(true);
   365      return;
   366    }
   367
   368    onInvestNow(asset);
   369   };
   370
