   759     useEffect(() => {
   760    if (!session?.user?.id) return;
   761    
   762    const userId = session.user.id;
   763    console.log("⏰ TIMER DEBUG: Starting INDIVIDUAL countdown for user:", userId); 
   764
   765    let interval: NodeJS.Timeout | null = null;
   766    const PAUSE_THRESHOLD = 25; // minutes before end to pause
   767
   768    const startIndividualCountdown = async () => {
   769      try {
   770        // 1. CHECK IF USER HAS INVESTED
   771        const { data: purchaseCheck } = await supabase
   772          .from('presale_purchases')
   773          .select('created_at')
   774          .eq('user_id', userId)
   775          .limit(1);
   776
   777        const userHasInvested = purchaseCheck && purchaseCheck.length > 0;
   778        
   779        console.log("💰 Investment status:", {
   780          invested: userHasInvested,
   781          purchaseCount: purchaseCheck?.length || 0
   782        });
   783
   784        // 2. GET/CREATE TIMER SESSION
   785        let timerStart: Date;
   786        
   787        const { data: sessionData } = await supabase
   788          .from('presale_sessions')
   789          .select('timer_started_at')
   790          .eq('user_id', userId)
   791          .maybeSingle();
   792
   793        if (sessionData?.timer_started_at) {
   794          // Use existing timer
   795          timerStart = new Date(sessionData.timer_started_at);
   796          console.log("⏰ Using existing timer start:", timerStart.toLocaleString());
   797        } else {
   798          // Create new timer starting NOW
   799          timerStart = new Date();
   800          console.log("⏰ Creating NEW timer start:", timerStart.toLocaleString());
   801          
   802          // Save to database
   803          await supabase
   804            .from('presale_sessions')
   805            .upsert({
   806              user_id: userId,
   807              timer_started_at: timerStart.toISOString(),
   808              updated_at: new Date().toISOString()
   809            }, {
   810              onConflict: 'user_id'
   811            });
   812        }
   813
   814        // 3. TIMER TICK FUNCTION
   815        const tick = () => {
   816          const now = new Date();
   817          const threeDaysMs = 3 * 24 * 60 * 60 * 1000;
   818          const endTime = new Date(timerStart.getTime() + threeDaysMs);
   819          let diff = endTime.getTime() - now.getTime();
   820          
   821          // CASE 1: Timer expired normally
   822          if (diff <= 0) {
   823            console.log("⏰ TIMER EXPIRED - Presale Ended");
   824            setTimeRemaining({ days: 0, hours: 0, minutes: 0, seconds: 0 });
   825            setPresaleEnded(true);
   826            if (interval) clearInterval(interval);
   827            
   828            // Show completion message for investors
   829            if (userHasInvested) {
   830              console.log("✅ INVESTOR: Your presale period has ended");
   831            }
   832            return;
   833          }
   834          
   835          // CASE 2: Not invested and 25 minutes remaining - PAUSE TIMER
   836          const minutesRemaining = Math.floor(diff / (1000 * 60));
   837          
   838          if (!userHasInvested && minutesRemaining <= PAUSE_THRESHOLD) {
   839            console.log("⏸ FOMO MODE ACTIVATED: Timer paused at 25 minutes");
   840            
   841            // Set timer to show 25:00 (static)
   842            setTimeRemaining({ 
   843              days: 0, 
   844              hours: 0, 
   845              minutes: PAUSE_THRESHOLD, 
   846              seconds: 0 
   847            });
   848            
   849            // Activate FOMO mode
   850            setIsFomoMode(true);
   851            const investorData = {
   852            total: 199,      // 199/200
   853            spots: 1,        // 1 spot left
   854            userPosition: 200 // You're #200
   855          };
   856            setDynamicInvestorCount(investorData);
   857
   858            return;
   859          }
   860          
   861          // CASE 3: Normal countdown (either invested or >25 minutes)
   862          const days = Math.floor(diff / (1000 * 60 * 60 * 24));
   863          const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
   864          const minutes = Math.floor((diff / (1000 * 60)) % 60);
   865          const seconds = Math.floor((diff / 1000) % 60);
   866          
   867          setTimeRemaining({ days, hours, minutes, seconds });
   868          setIsFomoMode(false); // Ensure FOMO is off during normal countdown
   869
   870         // ⬇ ALSO ADD IT HERE FOR NORMAL COUNTDOWN ⬇
   871         const goal = 200;
   872         let investorData;
   873    
   874         if (userHasInvested) {
   875         investorData = {
   876         total: goal, // 200
   877         spots: 0, // No spots left
   878         userPosition: virtualInvestors || goal
   879       };
   880        } else {
   881         const currentTotal = virtualInvestors; // Your current 195
   882         investorData = {
   883         total: currentTotal,
   884         spots: goal - currentTotal,
   885         userPosition: virtualInvestors
   886       };
   887     }
   888    setDynamicInvestorCount(investorData);
   889
   890          console.log("⏰ COUNTDOWN:", {
   891            days,
   892            hours,
   893            minutes,
   894            seconds,
   895            invested: userHasInvested,
   896            fomoActive: !userHasInvested && minutesRemaining <= PAUSE_THRESHOLD
   897          });
   898        };
   899
   900        // Start ticking
   901        tick();
   902        interval = setInterval(tick, 1000);
   903
   904      } catch (error) {
   905        console.error("❌ Timer initialization error:", error);
   906      }
   907    };
   908
   909    startIndividualCountdown();
   910
   911    // Cleanup
   912    return () => {
   913      if (interval) clearInterval(interval);
   914    };
   915  }, [session?.user?.id]);
