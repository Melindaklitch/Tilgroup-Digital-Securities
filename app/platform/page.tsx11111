   393            <div className="relative w-full h-64 rounded-lg overflow-hidden">
   394              <Image
   395                src={asset.image}
   396                alt={t(asset.nameKey)}
   397                fill
   398                className="object-cover"
   399              />
   400            </div>
   401
   402            {/* Spotlight Text */}
   403            <div className="bg-[#071526] p-4 rounded-lg">
   404              <p className="text-gray-300 italic">"{t(asset.spotlightKey)}"</p>
   405            </div>
   406
   407            {/* Physical Details */}
   408            <div className="bg-[#071526] p-4 rounded-lg">
   409              <h3 className="font-semibold text-lg mb-3">{t("asset_details.physical_details")}</h3>
   410              <div className="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
   411                {asset.physicalDetails && Object.entries(asset.physicalDetails).map(([key, value]) => (
   412                  <div key={key} className="flex justify-between border-b border-gray-700 pb-2">
   413                    <span className="text-gray-400 capitalize">
   414                      {t(`assetFieldLabels.${key}`)}:
   415                    </span>
