  1211     // ✅ NEW: Check Phantom's actual state on initial load
  1212  useEffect(() => {
  1213    console.log("🔍 [InitialSync] Checking Phantom's actual connection state...");
  1214    
  1215    if (typeof window === 'undefined') return;
  1216    
  1217    const phantom = window.phantom?.solana;
  1218    
  1219    if (!phantom?.isPhantom) {
  1220      console.log("❌ [InitialSync] Phantom wallet not detected");
  1221      return;
  1222    }
  1223    
  1224    // Check if Phantom says it's connected but our React state doesn't know
  1225    const isActuallyConnected = phantom.isConnected;
  1226    const phantomPublicKey = phantom.publicKey?.toString();
  1227    
  1228    console.log("📊 [InitialSync] Phantom reports:", {
  1229      isConnected: isActuallyConnected,
  1230      publicKey: phantomPublicKey,
  1231      ourStateConnected: connected, // Your existing connected state
  1232      ourStatePublicKey: publicKey?.toString() // Your existing publicKey state
  1233    });
  1234    
  1235    // If Phantom says connected but our state says disconnected - FIX IT
  1236    if (isActuallyConnected && phantomPublicKey && (!connected || !publicKey)) {
  1237      console.log("🔄 [InitialSync] Fixing state mismatch: Phantom is connected but app doesn't know!");
  1238      
  1239      // Update your connection state (assuming you have setters or context)
  1240      // This depends on how you manage wallet state. Examples:
  1241      
  1242      // If you're using a wallet context/provider:
  1243      // connect(); // Call your connect function
  1244      
  1245      // If you have state setters:
  1246      // setConnected(true);
  1247      // setPublicKey(new PublicKey(phantomPublicKey));
  1248      
  1249      console.log("✅ [InitialSync] State corrected to match Phantom");
  1250    } else if (!isActuallyConnected && connected) {
  1251      console.log("🔄 [InitialSync] Fixing: App thinks connected but Phantom says disconnected");
  1252      // Handle disconnect
  1253    }
  1254    
  1255    // Set up event listeners to keep in sync
  1256    const handlePhantomConnect = (eventPublicKey: any) => {
  1257      console.log("🔗 [Event] Phantom 'connect' event received");
  1258      // Your existing connection logic should handle this
  1259    };
  1260    
  1261    const handlePhantomDisconnect = () => {
  1262      console.log("🔌 [Event] Phantom 'disconnect' event received");
  1263      // Your disconnect logic should handle this
  1264    };
  1265    
  1266    if (phantom) {
  1267      phantom.on('connect', handlePhantomConnect);
  1268      phantom.on('disconnect', handlePhantomDisconnect);
  1269    }
  1270    
  1271    return () => {
  1272      if (phantom) {
  1273        phantom.off('connect', handlePhantomConnect);
  1274        phantom.off('disconnect', handlePhantomDisconnect);
  1275      }
  1276    };
  1277  }, []); // Run once on mount
  1278
  1279    // ✅ Automatically detect wallet connection and update profile + balances
  1280  useEffect(() => {
  1281    const updateWallet = async () => {
  1282      if (connected && publicKey) {
  1283        const key = publicKey.toString();
  1284        setWalletAddress(key);
  1285
  1286        // ✅ Save wallet to Supabase profile if logged in
  1287        if (session?.user?.id) {
  1288          const { error } = await supabase
  1289            .from("profiles")
  1290            .update({ wallet_address: key })
  1291            .eq("id", session.user.id);
  1292
  1293          if (error) {
  1294            console.error("Supabase update failed:", error);
  1295          } else {
  1296            console.log("Wallet address saved to Supabase:", key);
  1297          }
  1298        }
  1299
  1300        // ✅ Fetch balances after connection
  1301        fetchBalances(key);
  1302      }
  1303    };
  1304
  1305    updateWallet(); // ← Call the async function
  1306  }, [connected, publicKey, session, fetchBalances]);
  1307
  1308   // ✅ Reset wallet state on disconnect
  1309  useEffect(() => {
  1310    if (!connected) {
  1311      console.log("🔄 Wallet disconnected, resetting state");
  1312      setWalletAddress(null);
  1313      setSolBalance(null);
  1314      setUsdcBalance(null);
  1315    }
  1316  }, [connected]);
  1317
  1318  useEffect(() => {
  1319    const attemptConnection = async () => {
  1320      if (connected || walletConnecting) return;
  1321      
  1322      // Check for Phantom
  1323      if (typeof window === 'undefined') return;
  1324      const phantom = window.phantom?.solana;
  1325      if (!phantom?.isPhantom) {
  1326        console.log("👻 Phantom not found");
  1327        return;
  1328      }
  1329      
  1330      // 🆕 NEW CHECK: If Phantom says it's already connected, sync state
  1331      if (phantom.isConnected && phantom.publicKey && !connected) {
  1332        console.log("✅ [AutoConnect] Phantom already connected - syncing state");
  1333        
  1334        const phantomPublicKey = phantom.publicKey.toString();
  1335        console.log("🔑 Public key from Phantom:", phantomPublicKey);
  1336        
  1337        // Update your state to match Phantom
  1338        // This depends on your state management. Example:
  1339        // setConnected(true);
  1340        // setPublicKey(new PublicKey(phantomPublicKey));
  1341        
  1342        // Don't try to connect again if already connected
  1343        return;
  1344      }
  1345      
  1346      // Only attempt connection if Phantom isn't already connected
  1347      try {
  1348        console.log("🔄 [AutoConnect] Attempting silent Phantom connection...");
  1349        const response = await phantom.connect({ onlyIfTrusted: true });
  1350        console.log("✅ [AutoConnect] Phantom auto-connected:", response.publicKey.toString());
  1351      } catch (error) {
  1352        console.log("ℹ [AutoConnect] Phantom requires manual connection");
  1353      }
  1354    };
  1355    
  1356    // 🆕 CHANGE: Shorter delay for better UX
  1357    const timer = setTimeout(attemptConnection, 500); // Changed from 1500ms to 500ms
  1358    return () => clearTimeout(timer);
  1359  }, [connected, walletConnecting]);
  1360
  1361  // ✅ NEW: Periodic state verification
  1362  useEffect(() => {
  1363    // Don't run if no Phantom or already syncing
  1364    if (typeof window === 'undefined' || walletConnecting) return;
  1365    
  1366    const interval = setInterval(() => {
  1367      verifyWalletState();
  1368    }, 3000); // Check every 3 seconds
  1369    
  1370    return () => clearInterval(interval);
  1371  }, [walletConnecting]);
