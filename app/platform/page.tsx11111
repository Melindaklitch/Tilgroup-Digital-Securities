  1035   // Helper function to translate asset names
  1036  const translateAssetName = (assetKey: string, t: (key: string) => string) => {
  1037    const keyMappings: { [key: string]: string } = {
  1038      'PresaleAssets.portx.name': 'assets.portx.name',
  1039      'PresaleAssets.portConcessions.name': 'assets.portConcessions.name',
  1040      'PresaleAssets.dockingFees.name': 'assets.dockingFees.name', 
  1041      'PresaleAssets.containerHandling.name': 'assets.containerHandling.name',
  1042      'PresaleAssets.logisticsInfrastructure.name': 'assets.logisticsInfrastructure.name',
  1043      'PresaleAssets.straitPassageRights.name': 'assets.straitPassageRights.name'
  1044    };
  1045    
  1046    const actualKey = keyMappings[assetKey] || assetKey;
  1047    return t(actualKey);
  1048  };
