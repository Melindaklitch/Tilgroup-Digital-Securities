  2322          {/* Add this toast component with your other modals */}
  2323     {showPurchaseToast && latestPurchase && (
  2324         <div className="fixed top-4 right-4 bg-green-600 text-white p-4 rounded-lg shadow-lg z-50 animate-bounce">
  2325           <div className="flex items-center space-x-2">
  2326             <div className="text-xl">🎉</div>
  2327             <div>
  2328               <div className="font-semibold">{t("toast.new_investment")}</div>
  2329               <div className="text-sm">
  2330                 {t("toast.purchase_notification", { asset_name: latestPurchase.asset_name })}
  2331               </div>
  2332             </div>
  2333           </div>
  2334         </div>
  2335       )}
  2336
  2337      {showLegalModal && (
  2338          <div className="fixed inset-0 bg-black/80 flex items-center justify-center z-50">
  2339            <div className="bg-[#0f2a3f] rounded-xl max-w-2xl w-full max-h-[80vh] overflow-y-auto p-6">
  2340              <div className="flex justify-between items-center mb-6">
  2341                <h3 className="text-2xl font-bold">{t("legal.requirements")}</h3>
  2342                <button 
  2343                  onClick={() => setShowLegalModal(false)}
  2344                  className="text-gray-400 hover:text-white text-2xl"
  2345                >
  2346                  ×
  2347                </button>
  2348              </div>
  2349              
  2350              <div className="space-y-4">
  2351                <div className="flex justify-between items-center p-4 bg-[#071526] rounded-lg border border-gray-700">
  2352                  <div className="flex items-center space-x-4">
  2353                    <div className="bg-yellow-500 p-2 rounded">📄</div>
  2354                    <div>
  2355                      <h4 className="font-semibold text-white">{t("legal.token_purchase_agreement")}</h4>
  2356                      <p className="text-sm text-gray-400">{t("legal.required_for_all_investments")}</p>
  2357                    </div>
  2358                  </div>
  2359                  <Button
  2360                    variant="outline"
  2361                    size="sm"
  2362                    onClick={() =>
  2363                   typeof window !== "undefined" &&
  2364                   window.open("/legal/documents/token-purchase-agreement.pdf", "_blank")
  2365                 }
  2366                  >
  2367                    {t("common.view_pdf") || "View PDF"}
  2368                  </Button>
  2369                </div>
  2370              </div>
  2371              
  2372              <div className="mt-6 p-4 bg-[#071526] rounded-lg">
  2373                <div className="flex items-center space-x-3">
  2374                  <input 
  2375                    type="checkbox" 
  2376                    id="legal-acknowledge" 
  2377                    className="w-4 h-4"
  2378                    onChange={async (e) => {
  2379                      if (e.target.checked && session?.user?.id) {
  2380                        await supabase.from('legal_acknowledgements').upsert({
  2381                          user_id: session.user.id,
  2382                          document_type: 'token_purchase_agreement',
  2383                          acknowledged: true,
  2384                          acknowledged_at: new Date().toISOString()
  2385                        });
  2386                        
  2387                        const { data } = await supabase
  2388                          .from('user_legal_status')
  2389                          .select('*')
  2390                          .eq('user_id', session.user.id)
  2391                          .maybeSingle();
  2392                        
  2393                        setUserLegalStatus(data);
  2394                        setShowLegalModal(false);
  2395                      }
  2396                    }}
  2397                  />
  2398                  <label htmlFor="legal-acknowledge" className="text-sm text-gray-300">
  2399                    {t("legal.acknowledgment_points.read_documents")}
  2400                  </label>
  2401                </div>
  2402              </div>
  2403            </div>
  2404           </div>
  2405          )}
  2406       </div>
  2407     </div>
  2408    );
  2409
  2410  return <>{content}</>;
