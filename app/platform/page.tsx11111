   493    export default function PlatformPage() {
   494    const { connection } = useConnection();
   495    const { t, i18n } = useTranslation(); 
   496    const { connected, publicKey } = useWallet();
   497    const router = useRouter();
   498
   499    
   500    // State declarations
   501    const [isFomoMode, setIsFomoMode] = useState(false);
   502    const PRESALE_GOAL = 200;
   503    const [userPresaleStart, setUserPresaleStart] = useState<Date | null>(null);
   504    const [virtualInvestors, setVirtualInvestors] = useState(0);
   505    const [userHasInvested, setUserHasInvested] = useState(false);
   506    const [session, setSession] = useState<any>(null);
   507    const [walletAddress, setWalletAddress] = useState<string | null>(null);
   508    const [solBalance, setSolBalance] = useState<number | null>(null);
   509    const [isCheckingQuestionnaire, setIsCheckingQuestionnaire] = useState(true);
   510    const [usdcBalance, setUsdcBalance] = useState<number | null>(null);
   511    const [purchases, setPurchases] = useState<any[]>([]);
   512    const [loading, setLoading] = useState(true);
   513    const [userQuestionnaireCompleted, setUserQuestionnaireCompleted] = useState(false);
   514    const [showQuestionnaire, setShowQuestionnaire] = useState(false);
   515    const [userQuestionnaireStatus, setUserQuestionnaireStatus] = useState<any>(null);
   516    const [walletConnecting, setWalletConnecting] = useState(true);
   517    const [showModal, setShowModal] = useState(false);
   518    const [selectedAsset, setSelectedAsset] = useState<any>(null);
   519    const [selectedToken, setSelectedToken] = useState("SOL");
   520    const [showAssetDetail, setShowAssetDetail] = useState(false);
   521    const [selectedAssetDetail, setSelectedAssetDetail] = useState<any>(null);
   522    const [recentPurchases, setRecentPurchases] = useState<any[]>([]);
   523    const [presaleEnded, setPresaleEnded] = useState(false);
   524    const [showPurchaseToast, setShowPurchaseToast] = useState(false);
   525    const [latestPurchase, setLatestPurchase] = useState<any>(null);
   526    const [timeRemaining, setTimeRemaining] = useState({ 
   527      days: 3,
   528      hours: 59,
   529      minutes: 59,
   530      seconds: 59
   531  });
   532
   533    const [dynamicInvestorCount, setDynamicInvestorCount] = useState({
   534    total: 195,      // Starting total investors
   535    spots: 5,        // Starting spots remaining (200 - 195)
   536    userPosition: 197 // Starting user position
   537  });
   538
   539   const [questionnaireCompleted, setQuestionnaireCompleted] = useState(false);
   540   const [questionnaireStatus, setQuestionnaireStatus] = useState<'not_started' | 'pending' | 'qualified' | 'rejected'>('not_started');   
   541   const [hasShownQuestionnaire, setHasShownQuestionnaire] = useState(false);
   542   const totalSpots = 200;
   543   const filledSpots = virtualInvestors + 1; // 194 if virtualInvestors = 193
   544   const progress = (filledSpots / totalSpots) * 100;
   545   const spotsRemaining = totalSpots - filledSpots;
   546
   547   // Legal compliance state
   548    const [userLegalStatus, setUserLegalStatus] = useState<any>(null);
   549    const [showLegalModal, setShowLegalModal] = useState(false);
   550    const [legalAcknowledged, setLegalAcknowledged] = useState(false);
   551    const [showLegalRequirements, setShowLegalRequirements] = useState(false);
   552
   553       // Helper function to verify and sync wallet state
   554  const verifyWalletState = () => {
   555    if (typeof window === 'undefined') return false;
   556    
   557    const phantom = window.phantom?.solana;
   558    if (!phantom?.isPhantom) {
   559      console.log("⚠ verifyWalletState: Phantom not found");
   560      return false;
   561    }
   562    
   563    console.log("🔎 [Verify] Current state comparison:", {
   564      phantomConnected: phantom.isConnected,
   565      phantomPublicKey: phantom.publicKey?.toString(),
   566      appConnected: connected,
   567      appPublicKey: publicKey?.toString(),
   568      timestamp: new Date().toISOString()
   569    });
   570    
   571    // If states don't match, log warning
   572    if (phantom.isConnected !== connected) {
   573      console.warn("🚨 [Verify] STATE MISMATCH DETECTED!", {
   574        phantom: phantom.isConnected ? "connected" : "disconnected",
   575        app: connected ? "connected" : "disconnected",
   576        action: "Check connection logic"
   577      });
   578      
   579      // You could auto-correct here if needed
   580      if (phantom.isConnected && !connected) {
   581        console.log("🔄 [Verify] Auto-correcting: Setting app to connected");
   582        // setConnected(true);
   583      }
   584    }
   585    
   586    return phantom.isConnected === connected; // Returns true if states match
   587  };
